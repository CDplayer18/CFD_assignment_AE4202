FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1.0e5;

boundaryField
{
    inlet
    {
        type            totalPressure;
	p0		330860;
	gamma		1.4;
    }

    topWall
    {
        type            cyclic;
    }

	bottomWall
    {
        type            cyclic;
    }


    blade
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 154960;
    }
}


