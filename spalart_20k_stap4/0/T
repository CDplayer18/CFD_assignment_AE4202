FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293;


boundaryField
{
    inlet
    {
        type            totalTemperature;
	T0		420;
	gamma		1.4;
    }

    topWall
    {
        type            cyclic;
    }

	bottomWall
    {
        type            cyclic;
    }

    blade
    {
        type            fixedValue;
	value		uniform 300;
    }

    outlet
    {
        type            zeroGradient;
    }

}


