FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         none;

    div(phi,U)      Gauss limitedLinear 1;   // High-resolution for velocity
    div(U)          Gauss linear;

    div(phid,p)     Gauss upwind;            // Pressure-dilatation can often stay upwind for stability
    div(phiv,p)     Gauss linear;
    div(phi,K)      Gauss linear;
    div(phi,e)      Gauss upwind;

    // For Spalart-Allmaras, control nuTilde:
    div(phi,nuTilde) Gauss limitedLinear 1;  // High-resolution for SA turbulence

    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}


